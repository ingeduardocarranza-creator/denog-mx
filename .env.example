# Supabase — obtén estos valores en tu proyecto de Supabase (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# JWT — genera un string largo y aleatorio (mínimo 32 caracteres)
JWT_SECRET=genera-un-secreto-largo-y-aleatorio-aqui

# Google Maps — necesario para calcular distancia en domicilios
GOOGLE_MAPS_API_KEY=tu-api-key-de-google-maps

# Anthropic — usado por el clasificador de Pendientes y por sugerir-nombre
ANTHROPIC_API_KEY=tu-api-key-de-anthropic

# WhatsApp Cloud API — ver docs/PLAN.md y docs/META_PASO_A_PASO.md
WHATSAPP_TOKEN=el-token-permanente-del-usuario-del-sistema
WHATSAPP_PHONE_NUMBER_ID=206272094692390
WHATSAPP_BUSINESS_ACCOUNT_ID=2988570078091964
# Cualquier string largo que tú inventes — lo escribes también en Meta al
# configurar la URL del webhook, en el campo "Token de verificación".
WHATSAPP_VERIFY_TOKEN=inventa-un-string-largo-aqui
# Meta → tu app → Configuración → Básica → "Clave secreta de la app".
# Se usa para verificar que los webhooks de verdad vienen de Meta.
WHATSAPP_APP_SECRET=la-clave-secreta-de-la-app-de-meta

# Embedded Signup (/admin/conectar-whatsapp, B7) — cuenta tipo SMB, es el
# único camino para vincular coexistencia. Públicas a propósito (van al
# navegador): no son secretas, solo identifican la app y la configuración
# de "Inicio de sesión con Facebook para empresas".
NEXT_PUBLIC_WHATSAPP_APP_ID=el-id-de-tu-app-de-meta
NEXT_PUBLIC_WHATSAPP_CONFIG_ID=el-config-id-de-inicio-de-sesion-con-facebook
